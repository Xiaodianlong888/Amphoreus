Buffs: {
	BaoJinBi_Buff: {
		DisplayName: 爆金币Buff
		Description: 攻击时有一定概率爆出金币
	}

	Buff_DaDi: {
		DisplayName: 磐岩之脊
		Description: 免疫多种负面效果，获得基于防御力的大地护盾
		DetailedDescription:
			'''
			• 大地祝福
			• 按防御力提供护盾
			剩余时间: {0}
			'''
	}

	Buff_FenZheng: {
		DisplayName: 天谴之矛
		Description: 增加近战属性，防御转生命，嘲讽敌人
	}

	Buff_FuShi: {
		DisplayName: 全世之座
		Description:
			'''
			提供高额属性加成，额外拥有所有神谕牌的效果
			禁用其他神谕牌的效果
			'''
	}

	Buff_GuiJi: {
		DisplayName: 翻飞之币
		Description: 可隐身移速+15%，概率不消耗宝藏袋，攻击标记'爆金币'
	}

	Buff_HaiYang: {
		DisplayName: 满溢之杯
		Description: 水中畅通无阻，水/雨中伤害翻倍
	}

	Buff_LangMan: {
		DisplayName: 黄金之茧
		Description:
			'''
			增加移速
			攻速越高收益越高
			'''
	}

	Buff_LiXing: {
		DisplayName: 分裂之枝
		Description: 增加远程属性，攻击附加减益
	}

	Buff_LvFa: {
		DisplayName: 公正之秤
		Description:
			'''
			可触发双倍伤害免疫魔力病
			技能：交换生命与魔力，可在控件绑定键位
			'''
	}

	Buff_MenJing: {
		DisplayName: 万径之门
		Description:
			'''
			拥有召唤物越多伤害越高
			技能：复制所有召唤物，可在控件绑定键位
			'''
	}

	Buff_SiWang: {
		DisplayName: 灰黯之手
		Description: 损失生命增加伤害，恢复生命积攒新蕊，可免疫死亡，可召唤鬼手汲取生命
	}

	Buff_SuiYue: {
		DisplayName: 永夜之帷
		Description:
			'''
			按时间增加自身与敌人的易伤比例
			技能：时间回溯，可在控件绑定键位
			'''
	}

	Buff_TianKong: {
		DisplayName: 晨昏之眼
		Description: 无限飞行，晴天增加伤害，雷雨增加暴击
	}

	MimiBuff: {
		DisplayName: 迷迷的声援
		Description: 迷迷为你加油，提供闪避能力，暴击率+4%
		DetailedDescription:
			'''
			• 迷迷为你加油
			• 提供闪避能力，暴击率+4%
			剩余时间: {0}
			'''
	}

	XilianDebuff: {
		DisplayName: 追忆
		Description: 来自昔涟的祝福
	}

	SpeedLieBuff: {
		DisplayName: 速猎Buff
		Description: 增加狩猎速度
	}
}

