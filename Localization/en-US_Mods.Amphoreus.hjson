NPCs: {
	SFeir.DisplayName: SFeir

	//迷迷
	Mimi: {
		DisplayName: Mimi
		Bestiary: A pink little fairy that will help you by your side.

		System: {
			HeardCall: Mimi heard your call...
			EnterIdleMode: Mimi couldn't find a player to follow and is resting.
			Transformed: Mimi has transformed into Xilian!
			SwitchMode:
				'''
				Current topic: {0}
				Click the right side to chat about the topic.
				'''

			ToggleIdle: {
				Idle: {
					Early: meme me... (I, rest...)
					Mid: meme rest... (I, rest...)
					Fluent: I'll take a rest...
				}

				Active: {
					Early: meme me! (I, ready! Good!)
					Mid: meme ready! (I'm ready! Okay!)
					Fluent: I'm ready for the adventure! ♪
				}
			}
		}

		// 系统提示文本
		CallResponse: {
			Idle: {
				Early: meme! (I'm coming!)
				Mid: meme coming! (I'm coming!)
				Fluent: Mee! I'm coming!
			}

			Active: {
				Early: meme! (I'm here!)
				Mid: meme here! (I'm here!)
				Fluent: Mee! I'm here!
			}
		}

		// 呼唤响应
		Dialogue: {
			FirstMeeting: {
				Early: me! meme~ (Hello, I'm Mimi!)
				Mid: me! meme~ (Hello, I'm Mimi!)
				Fluent: me! meme~ (Hello, I'm Mimi!)
			}

			Daily: {
				Early:
					'''
					me mememe meme~ (Mimi Mimi~)
					meme? (Mimi?)
					me me me~ (Flower, bud, Mi~)
					meme meme! (Happy)
					me? me~ (Mimi?)
					'''
				Mid:
					'''
					meme help, me! (I'll help you.)
					me happy, meme~ (Happy today~)
					meme me together! (Adventure together!)
					me wait, meme... (I'll wait for you...)
					meme protect, me! (I'll protect you!)
					'''
				Fluent:
					'''
					The weather is lovely today!
					I'm so happy to be with you.
					Shall we go on an adventure?
					I'll always be with you!
					Need any help?
					'''
			}

			Growth: {
				Early:
					'''
					me me... (Will I change?)
					meme? (Change?)
					me me me! (I want to be stronger!)
					meme me~ (I'll try hard~)
					'''
				Mid:
					'''
					meme look forward... (I'm looking forward to it.)
					meme change... (How will I change?)
					meme think... (I want to be stronger!)
					meme effort~ (I'll do my best.)
					'''
				Fluent:
					'''
					I believe the next journey will be full of rewards!
					I wonder how I will change...
					I want to become stronger and protect you!
					I will work hard to grow!
					'''
			}
		}

		// 对话内容
		FunctionModes: {
			Chat: {
				DisplayName: Chat
				Early: meme! (Chat!)
				Mid: meme chat! (Let's chat!)
				Fluent: Let's have a chat!
			}

			IdleToggle: {
				DisplayName: Toggle Idle

				Idle: {
					Early: meme me... (I want to rest...)
					Mid: meme rest... (I want to rest a bit.)
					Fluent: I want to rest a bit...
				}

				Active: {
					Early: meme me! (I'm ready! Good!)
					Mid: meme ready! (I'm ready! Okay!)
					Fluent: I'm ready!
				}
			}

			Transform: {
				DisplayName: Transform

				Transform: {
					Early: meme me? (Transform?)
					Mid: meme change? (Transform?)
					Fluent: Want to transform?
				}

				Growth: {
					Early: meme?
					Mid: meme?
					Fluent: Mimi?
				}
			}

			Inventory: {
				DisplayName: Inventory
				Early: meme me? (Inventory?)
				Mid: meme bag? (Open inventory?)
				Fluent: Want to open the bag?
			}

			Expressions: {
				DisplayName: Expressions
				Early: meme me me! (I can make expressions!)
				Mid: meme expressions! (I can make lots of expressions!)
				Fluent: I can make lots of expressions!
			}

			Quest: {
				DisplayName: Quest

				CanSubmit: {
					Early: meme me? (Collected?)
					Mid: meme collect? (Collected?)
					Fluent: Have you collected everything?
				}

				NeedHint: {
					Early: meme me? (Hint?)
					Mid: meme hint? (Need a hint?)
					Fluent: Need a hint?
				}

				HasSomethingToSay: {
					Early: meme me me! (I have something to say.)
					Mid: meme have words~ (I have something to tell you.)
					Fluent: I have something to tell you~
				}

				Wish: {
					Early: meme meme! (Thank you!)
					Mid: meme thank! (Thank you.)
					Fluent: Thank you for all your help!
				}

				Complete: {
					Early: meme meme! (Thank you!)
					Mid: meme thank! (Thank you!)
					Fluent: Thank you for all your help!
				}

				Progress: {
					Early:
						'''
						me me... (No rush)
						me me (need):

						'''
					Mid:
						'''
						meme no rush... (No rush, I'll wait for you.)
						meme need:

						'''
					Fluent:
						'''
						I'll wait for you.
						Need:

						'''
				}
			}
		}

		// 功能模式
		Buttons: {
			ChangeTopic: Change topic
			Chat: Chat
			AdventureTogether: Let's go on an adventure!
			Rest: Rest a bit~
			Transform: Transform!
			Growth: Grow
			OpenBackpack: Open bag
			MakeExpression: Make an expression~
			Submit: Submit
			Hint: Hint
			HasSomethingToSay: Mimi has something to say
			Wish: Wish
		}

		// 按钮文本
		Expressions: {
			Wink: {
				Early:
					'''
					me~
					me♪
					'''
				Mid:
					'''
					me~
					mi♪
					'''
				Fluent:
					'''
					Mi~
					Mi♪
					'''
			}

			Happy: {
				Early:
					'''
					meme meme! (Happy!)
					me me~ (So happy)
					'''
				Mid:
					'''
					Happy meme! (So happy!)
					me happy~ (Very happy)
					'''
				Fluent:
					'''
					So happy!
					I'm so happy with you~
					'''
			}

			Thinking: {
				Early:
					'''
					me... (Thinking)
					meme... (Thinking)
					'''
				Mid:
					'''
					meme think... (Thinking about something.)
					me think... (Thinking)
					'''
				Fluent:
					'''
					Hmm... let me think.
					Thinking~
					'''
			}

			Confused: {
				Early:
					'''
					me? (Confused)
					meme? (?)
					'''
				Mid:
					'''
					meme don't understand... (Not quite understand.)
					me confused? (A bit confused.)
					'''
				Fluent:
					'''
					Mi? Not quite understand.
					A bit confused...
					'''
			}

			Angry: {
				Early:
					'''
					meme! me! (Angry)
					me me! (Not happy)
					'''
				Mid:
					'''
					meme angry! (A bit angry.)
					me not happy! (Not very happy.)
					'''
				Fluent:
					'''
					Hmph!
					Not happy!
					'''
			}

			MimiGag: {
				Early:
					'''
					me—— (—v—)
					me—— (Mimi...)
					'''
				Mid:
					'''
					me—— (—v—)
					me—— (Mimi...)
					'''
				Fluent:
					'''
					meme— (—v—)
					me—— (Mimi...)
					'''
			}

			Sleeping: {
				Early:
					'''
					me...zzZ
					meme zzZ
					'''
				Mid:
					'''
					meme sleep... (So sleepy)
					me tired... (Want to sleep)
					'''
				Fluent:
					'''
					So sleepy...zzZ
					I'm a bit tired...
					'''
			}

			Serious: {
				Early:
					'''
					me!
					meme!
					'''
				Mid:
					'''
					meme serious! (Serious face)
					me serious (Serious mode.)
					'''
				Fluent:
					'''
					Serious mode!
					I'm very serious now!
					'''
			}

			Default: {
				Early:
					'''
					meme!
					me? (What's wrong?)?
					meme me~ (Here.)~
					'''
				Mid:
					'''
					me mi!
					me? what, me?
					meme this, me~ (Here.)
					'''
				Fluent:
					'''
					Mimi!
					Hm? What's up?
					I'm here~
					'''
			}
		}

		// 迷迷快乐值城镇NPC心情文本
		TownNPCMood: {
			Content: (Happy)
			NoHome: (Free)
			FarFromHome: (Carefree)
			LoveSpace: (Fluttering happily)
			DislikeCrowded: (Flying slowly)
			HateCrowded: (Can't fly anymore)
			LikeNPC_Princess: (Likes {NPCName})
			Princess_LovesNPC: (Likes {NPCName})
		}
	}

	//昔涟
	Xilian: {
		DisplayName: Xilian
		// 图鉴描述
		Bestiary:
			'''
			Shooting stars streak across the night sky, rippling the river of life with thirteen hues.
			She plants seeds of memory, letting past flowers bloom in tomorrow—
			"And then, let's write a poem unlike any before♪"
			'''
		Dialogue.Daily:
			'''
			Want to chat with me?
			Hi~ Did you miss me?
			Remember, when you run into trouble, call my name♪
			Hmm~ yeah↘ yeah↗ hmm yeah—hmm uh—hmm uh—(Once made a wish, waiting for you to appear)
			The guide always gives me gentle advice, like a talking tree♪
			Planting flowers with the Dryad sister makes the wind smell sweet~
			The Princess's dress is my favorite pink, we promised to have tea together♪
			The Angler kid talks tough, but I know he just wants someone to play with♪
			The Demolitionist always says it's dangerous, but he's the most careless—I'll bring you a charm next time?
			The Arms Dealer's gaze is a bit strange… but after I helped him organize his bullet boxes, he seemed a little kinder?
			The Pirate's parrot speaks so well—"You're so pretty!"—See, even he says so♪
			The Tax Collector isn't bad, just lonely. When I greet him, his eyes light up♪
			The Zoologist always wants to touch my ears when I'm in Mimi form… hehe, it actually feels quite nice♪
			The Stylist's hands are so light and soft, I feel like a new person after each haircut~
			The Dye Trader knows so much about pink! We chatted all afternoon, she promised to mix a "Xilian Special Pink" for me♪
			The Bartender pours me a little ale, I only take a sip and leave the rest for you♪
			The Cyborg speaks oddly… but when he says "Detected warm life signal," my heart warms too♪
			The Golfer taught me to swing, but the ball flew into the bushes—he said "You did well," hehe♪
			The Wizard says things I don't understand… but the crystal ball he gave me glows at night, like stars♪
			The Witch Doctor is so serious when making charms, I barely dared to breathe watching him—
			The Clothier speaks like an old man, but his needlework is amazing! He offered to teach me to embroider little flowers♪
			The Truffle says others want to eat him… hehe, I won't. I just want to hear his mushroom stories♪
			The Mechanic fixes things while I hand her wrenches—though I handed the wrong ones several times, she didn't get mad!
			The Party Girl is too enthusiastic! I was dragged into an hour of dancing, my legs are still sore… but it was so fun♪
			The Goblin Tinkerer hammers in the corner, I watch from afar and don't dare disturb—but his little clockwork toys are so fun!
			The Nurse talks tough but her hands are gentle when bandaging. "Be careful next time!"—hehe, I know♪
			The Painter gave me a painting! It's just a few pink flowers, but I hang it up and look at it every day♪
			The Steampunker's hat is so tall! I look up at her, she looks down and says "Little girl, who are you looking for?"—hehe, I'm not little!
			The Traveling Merchant always has odd things, I could squat at his stall all day~
			Santa Claus said "Good children get gifts," I secretly asked him, "Can I have a star?" He laughed for a long time♪
			The Skeleton Merchant sells strange things… but he's stranger—a skeleton afraid of rain. I want to hold an umbrella for him♪
			'''

		// 功能模式名称
		FunctionModes: {
			Chat: {
				DisplayName: Chat
				Dialogue: Want to chat with me~
			}

			OracleCard: {
				DisplayName: Oracle Cards
				Dialogue: I have many magical little cards~
			}

			Shop: {
				DisplayName: Shop
				Dialogue: My little shop is open, want to take a look?
			}

			Transform: {
				DisplayName: Transform
				Enabled: I can turn back into Mimi~
				Disabled: Wow, cheating right in front of me! No no~ Go defeat the Wall of Flesh first~
			}
		}

		// 按钮文本
		Buttons: {
			ChangeTopic: Change topic
			Chat: Chat
			OracleCard: Oracle Cards
			Shop: Shop
			Transform: Transform
		}

		// 昔涟城镇NPC心情文本
		TownNPCMood: {
			Content: ♪
			NoHome: I'll look for a place to rest.
			FarFromHome: A bit far from home.
			LoveSpace: So spacious, I feel relaxed.
			DislikeCrowded: A bit hard to breathe...
			HateCrowded: I'm... suffocating......
			LoveBiome: I really love {BiomeName}.
			LikeBiome: I like {BiomeName}.
			LoveNPC: I really love {NPCName}.
			LikeNPC_Princess: I like {NPCName}.
			Princess_LovesNPC: I love {NPCName}.
			DislikeBiome: 我不喜欢{BiomeName}。
			LikeNPC: 我喜欢{NPCName}。
		}
	}
}

