NPCs: {
	SFeir.DisplayName: SFeir

	//迷迷
	Mimi: {
		DisplayName: Mimi
		Bestiary: A pink little fairy that will help you by your side.

		System: {
			HeardCall: Mimi heard your call...
			EnterIdleMode: Mimi couldn't find a player to follow and is resting.
			Transformed: Mimi has transformed into Xilian!
			SwitchMode:
				'''
				Current topic: {0}
				Click the right side to chat about the topic.
				'''

			ToggleIdle: {
				Idle: {
					Early: meme me... (I, rest...)
					Mid: meme rest... (I, rest...)
					Fluent: I'll take a rest...
				}

				Active: {
					Early: meme me! (I, ready! Good!)
					Mid: meme ready! (I'm ready! Okay!)
					Fluent: I'm ready for the adventure! ♪
				}
			}
		}

		// 系统提示文本
		CallResponse: {
			Idle: {
				Early: meme! (I'm coming!)
				Mid: meme coming! (I'm coming!)
				Fluent: Mee! I'm coming!
			}

			Active: {
				Early: meme! (I'm here!)
				Mid: meme here! (I'm here!)
				Fluent: Mee! I'm here!
			}
		}

		// 呼唤响应
		Dialogue: {
			FirstMeeting: {
				Early: me! meme~ (Hello, I'm Mimi!)
				Mid: me! meme~ (Hello, I'm Mimi!)
				Fluent: me! meme~ (Hello, I'm Mimi!)
			}

			Daily: {
				Early:
					'''
					me mememe meme~ (Mimi Mimi~)
					meme? (Mimi?)
					me me me~ (Flower, bud, Mi~)
					meme meme! (Happy)
					me? me~ (Mimi?)
					'''
				Mid:
					'''
					meme help, me! (I'll help you.)
					me happy, meme~ (Happy today~)
					meme me together! (Adventure together!)
					me wait, meme... (I'll wait for you...)
					meme protect, me! (I'll protect you!)
					'''
				Fluent:
					'''
					The weather is lovely today!
					I'm so happy to be with you.
					Shall we go on an adventure?
					I'll always be with you!
					Need any help?
					'''
			}

			Growth: {
				Early:
					'''
					me me... (Will I change?)
					meme? (Change?)
					me me me! (I want to be stronger!)
					meme me~ (I'll try hard~)
					'''
				Mid:
					'''
					meme look forward... (I'm looking forward to it.)
					meme change... (How will I change?)
					meme think... (I want to be stronger!)
					meme effort~ (I'll do my best.)
					'''
				Fluent:
					'''
					I believe the next journey will be full of rewards!
					I wonder how I will change...
					I want to become stronger and protect you!
					I will work hard to grow!
					'''
			}
		}

		// 对话内容
		FunctionModes: {
			Chat: {
				DisplayName: Chat
				Early: meme! (Chat!)
				Mid: meme chat! (Let's chat!)
				Fluent: Let's have a chat!
			}

			IdleToggle: {
				DisplayName: Toggle Idle

				Idle: {
					Early: meme me... (I want to rest...)
					Mid: meme rest... (I want to rest a bit.)
					Fluent: I want to rest a bit...
				}

				Active: {
					Early: meme me! (I'm ready! Good!)
					Mid: meme ready! (I'm ready! Okay!)
					Fluent: I'm ready!
				}
			}

			Transform: {
				DisplayName: Transform

				Transform: {
					Early: meme me? (Transform?)
					Mid: meme change? (Transform?)
					Fluent: Want to transform?
				}

				Growth: {
					Early: meme?
					Mid: meme?
					Fluent: Mimi?
				}
			}

			Inventory: {
				DisplayName: Inventory
				Early: meme me? (Inventory?)
				Mid: meme bag? (Open inventory?)
				Fluent: Want to open the bag?
			}

			Expressions: {
				DisplayName: Expressions
				Early: meme me me! (I can make expressions!)
				Mid: meme expressions! (I can make lots of expressions!)
				Fluent: I can make lots of expressions!
			}

			Quest: {
				DisplayName: Quest

				CanSubmit: {
					Early: meme me? (Collected?)
					Mid: meme collect? (Collected?)
					Fluent: Have you collected everything?
				}

				NeedHint: {
					Early: meme me? (Hint?)
					Mid: meme hint? (Need a hint?)
					Fluent: Need a hint?
				}

				HasSomethingToSay: {
					Early: meme me me! (I have something to say.)
					Mid: meme have words~ (I have something to tell you.)
					Fluent: I have something to tell you~
				}

				Wish: {
					Early: meme meme! (Thank you!)
					Mid: meme thank! (Thank you.)
					Fluent: Thank you for all your help!
				}

				Complete: {
					Early: meme meme! (Thank you!)
					Mid: meme thank! (Thank you!)
					Fluent: Thank you for all your help!
				}

				Progress: {
					Early:
						'''
						me me... (No rush)
						me me (need):

						'''
					Mid:
						'''
						meme no rush... (No rush, I'll wait for you.)
						meme need:

						'''
					Fluent:
						'''
						I'll wait for you.
						Need:

						'''
				}
			}
		}

		// 功能模式
		Buttons: {
