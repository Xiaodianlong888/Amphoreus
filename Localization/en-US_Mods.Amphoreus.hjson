Buffs: {
	BaoJinBi_Buff: {
		DisplayName: Gold Explosion Buff
		Description: Attacks have a chance to drop gold coins.
	}

	Buff_DaDi: {
		DisplayName: Spine of Bedrock
		Description: Immune to many negative effects, gain an earth shield based on defense.
		DetailedDescription:
			'''
			• Earth Blessing
			• Provides shield based on defense
			Remaining time: {0}
			'''
	}

	Buff_FenZheng: {
		DisplayName: Spear of Divine Punishment
		Description: Increases melee stats, converts defense to health, taunts enemies.
	}

	Buff_FuShi: {
		DisplayName: Throne of the World
		Description:
			'''
			Provides high stat bonuses and gains the effects of all Oracle Cards.
			Disables the effects of other Oracle Cards.
			'''
	}

	Buff_GuiJi: {
		DisplayName: Flipping Coin
		Description: Grants invisibility, +15% movement speed, chance to not consume Treasure Bag, attacks mark 'Gold Explosion'.
	}

	Buff_HaiYang: {
		DisplayName: Overflowing Cup
		Description: Unrestricted movement in water, damage doubled in water/rain.
	}

	Buff_LangMan: {
		DisplayName: Golden Cocoon
		Description:
			'''
			Increases movement speed.
			Higher attack speed gives higher returns.
			'''
	}

	Buff_LiXing: {
		DisplayName: Branch of Division
		Description: Increases ranged stats, attacks apply debuffs.
	}

	Buff_LvFa: {
		DisplayName: Scales of Justice
		Description:
			'''
			Can trigger double damage, immune to Mana Sickness.
			Skill: Swap health and mana, bindable in controls.
			'''
	}

	Buff_MenJing: {
		DisplayName: Gate of Myriad Paths
		Description:
			'''
			More summons = more damage.
			Skill: Duplicate all summons, bindable in controls.
			'''
	}

	Buff_SiWang: {
		DisplayName: Ash-Grey Hand
		Description: Lose health to increase damage, recover health to accumulate new buds, can cheat death, summon ghostly hand to drain life.
	}

	Buff_SuiYue: {
		DisplayName: Veil of Eternal Night
		Description:
			'''
			Increases vulnerability for self and enemies over time.
			Skill: Time Rewind, bindable in controls.
			'''
	}

	Buff_TianKong: {
		DisplayName: Eye of Dusk and Dawn
		Description: Infinite flight, increased damage on sunny days, increased crit in thunderstorms.
	}

	MimiBuff: {
		DisplayName: Mimi's Cheer
		Description: Mimi cheers you on, providing dodge ability and +4% crit chance.
		DetailedDescription:
			'''
			• Mimi cheers for you
			• Provides dodge ability and +4% crit chance
			Remaining time: {0}
			'''
	}

	XilianDebuff: {
		DisplayName: Reminiscence
		Description: Blessing from Xilian.
	}

	SpeedLieBuff: {
