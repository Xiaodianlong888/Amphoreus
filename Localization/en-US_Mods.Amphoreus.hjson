// ===== 系统本地化 =====
Systems: {
	XiLian_Systems: {
		Xinyuan: {
			MimiQuest: {
				// 系统提示
				System: {
					NewWish: Mimi has a new wish...
					CanSpeak: Mimi can actually talk?! "Mi?! Umm... test, test, one two three, test test one two three... I don't know why, but it's amazing!"
				}

				// 任务1：暗淡的吊坠
				LifeCrystalStage1: {
					Title: Dim Pendant
					Description: me...meme me? (Pendant, dim. Red, stone. Help.)
					CompletionText: The pendant reacted! Now Mimi can unleash a huge Mimi Claw!
					RewardDescription: Unlocks Big Mimi Claw attack
					LockedHint: (No unlock condition yet)
				}

				// 任务2：微弱的光
				LifeCrystalStage2: {
					Title: Faint Light
					Description: meme light! me not enough, meme~ (Pendant, glowing! But, not enough... Please, help again! Pretty please~)
					CompletionText: The pendant is shiny! Now Mimi can provide you with stat bonuses!
					RewardDescription: Unlocks stat buff ability
					LockedHint: Requires defeating Brain of Cthulhu or Eater of Worlds
				}

				// 任务3：妖精魔法
				LifeCrystalStage3: {
					Title: Fairy Magic
					Description: Mi... Life Crystals are less effective... Let's try Mana Stars? But maybe need a bit of Life Crystal too.
					CompletionText: The pendant regained its power! Now Mimi can help you dodge dangers!
					RewardDescription: Unlocks dodge ability
					LockedHint: Requires defeating Skeletron
				}
			}
		}

		Xingtai: {
			BossEventSystem: {
				MimiResting: Mimi is resting and cannot help, but you can call her!
				MimiComing: Mimi senses danger and is coming to help!
				BattleEndDelay: Battle over? Mimi is sensing if there's still danger...
				BattleResume: Battle continues!
				BattleEnd: Battle ended, threat gone, Mimi relaxes.
			}
		}
	}

	//向导
	GuideDialogue: {
		GiveQuill:
			'''
			Hey, wait... I've been looking for you!
			[c/FF6BCB:(The Guide pulls a purple-glowing quill from his pocket)]
			This quill seems to have been searching for its owner...
			I feel it radiates some kind of magic. Maybe you can use it to record important memories?
			'''
		ObtainedItem: "[c/FF6BCB:{0}] received [c/AA66FF:{1}] from the Guide!"
		MimiLocked: You haven't met Mimi yet? I heard she appears by your side, maybe you need to do something first...
		MimiUnlocked: I see Mimi following you, what a cute little one! She seems able to fight and make all kinds of expressions.
		XilianUnlocked: Xilian is by your side, she seems to wield power from another world. Talking to her might get you Oracle Cards.
	}
}

