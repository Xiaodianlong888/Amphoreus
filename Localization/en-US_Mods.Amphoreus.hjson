					'''
					Mi? Not quite understand.
					A bit confused...
					'''
			}

			Angry: {
				Early:
					'''
					meme! me! (Angry)
					me me! (Not happy)
					'''
				Mid:
					'''
					meme angry! (A bit angry.)
					me not happy! (Not very happy.)
					'''
				Fluent:
					'''
					Hmph!
					Not happy!
					'''
			}

			MimiGag: {
				Early:
					'''
					me—— (—v—)
					me—— (Mimi...)
					'''
				Mid:
					'''
					me—— (—v—)
					me—— (Mimi...)
					'''
				Fluent:
					'''
					meme— (—v—)
					me—— (Mimi...)
					'''
			}

			Sleeping: {
				Early:
					'''
					me...zzZ
					meme zzZ
					'''
				Mid:
					'''
					meme sleep... (So sleepy)
					me tired... (Want to sleep)
					'''
				Fluent:
					'''
					So sleepy...zzZ
					I'm a bit tired...
					'''
			}

			Serious: {
				Early:
					'''
					me!
					meme!
					'''
				Mid:
					'''
					meme serious! (Serious face)
					me serious (Serious mode.)
					'''
				Fluent:
					'''
					Serious mode!
					I'm very serious now!
					'''
			}

			Default: {
				Early:
					'''
					meme!
					me? (What's wrong?)?
					meme me~ (Here.)~
					'''
				Mid:
					'''
					me mi!
					me? what, me?
					meme this, me~ (Here.)
					'''
				Fluent:
					'''
					Mimi!
					Hm? What's up?
					I'm here~
					'''
			}
		}

		// 迷迷快乐值城镇NPC心情文本
		TownNPCMood: {
			Content: (Happy)
			NoHome: (Free)
			FarFromHome: (Carefree)
			LoveSpace: (Fluttering happily)
			DislikeCrowded: (Flying slowly)
